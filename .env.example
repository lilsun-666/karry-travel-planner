# ========================================
# Karry旅行家 - 环境变量配置模板
# ========================================
# 复制此文件为 .env 并填入真实值
# 示例：cp .env.example .env

# ========================================
# 🤖 豆包AI API配置（必需）
# ========================================

# API密钥
# 获取地址：https://console.volcengine.com/ark
DOUBAO_API_KEY=your_api_key_here

# 模型端点ID
# 获取地址：https://console.volcengine.com/ark
DOUBAO_ENDPOINT_ID=your_endpoint_id_here

# ========================================
# 🌐 服务器配置（可选）
# ========================================

# 服务端口（默认3000）
PORT=3000

# 运行环境（development/production）
NODE_ENV=development

# ========================================
# 🔒 安全配置（可选）
# ========================================

# CORS允许的来源（逗号分隔）
# 示例：http://localhost:3000,https://your-domain.com
CORS_ORIGINS=*

# 启用HTTPS（仅用于反向代理）
# 使用nginx/caddy时设置
FORCE_HTTPS=false

# ========================================
# 📊 日志配置（可选）
# ========================================

# 日志级别（debug/info/warn/error）
LOG_LEVEL=info

# 启用请求日志
LOG_REQUESTS=true
